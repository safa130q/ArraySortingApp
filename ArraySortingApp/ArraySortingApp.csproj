<!-- 
  Файл проекта .csproj - содержит настройки компиляции и зависимости
-->
<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Тип выходного файла: WinExe - оконное приложение Windows -->
		<OutputType>WinExe</OutputType>

		<!-- Целевая платформа: .NET 8.0 для Windows -->
		<TargetFramework>net8.0-windows</TargetFramework>

		<!-- Включаем проверку на null (защита от ошибок) -->
		<Nullable>enable</Nullable>

		<!-- Используем WPF для графического интерфейса -->
		<UseWPF>true</UseWPF>

		<!-- Автоматически добавляем using для стандартных библиотек -->
		<ImplicitUsings>enable</ImplicitUsings>
	</PropertyGroup>

	<ItemGroup>
		<!-- Пакет для работы с SQLite через Entity Framework Core -->
		<PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.0" />

		<!-- Инструменты для миграций базы данных -->
		<PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="8.0.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

</Project>