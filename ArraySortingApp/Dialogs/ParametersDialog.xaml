<!-- 
  Диалоговое окно для ввода параметров генерации массива
  Появляется при нажатии кнопки "Сгенерировать"
-->
<Window x:Class="ArraySortingApp.Dialogs.ParametersDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Параметры генерации массива"
	Width="350" Height="250"              
	WindowStartupLocation="CenterOwner"   
	ResizeMode="NoResize">
	<Grid Margin="20">
		<!-- Основная сетка с отступами 20 пикселей -->

		<!-- Определяем строки сетки -->
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<!-- Автоматическая высота -->
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<!-- Занимает всё оставшееся место -->
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<!-- Строка 0: Поле "Минимум" -->
		<Grid Grid.Row="0" Margin="0,0,0,15">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="120"/>
				<!-- Фиксированная ширина для текста -->
				<ColumnDefinition Width="*"/>
				<!-- Оставшееся место для поля ввода -->
			</Grid.ColumnDefinitions>
			<Label Content="Минимум:" VerticalAlignment="Center"/>
			<!-- Текст метки -->
			<TextBox x:Name="MinTextBox" Grid.Column="1" Height="25"/>
			<!-- Поле ввода с именем MinTextBox -->
		</Grid>

		<!-- Строка 1: Поле "Максимум" -->
		<Grid Grid.Row="1" Margin="0,0,0,15">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="120"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>
			<Label Content="Максимум:" VerticalAlignment="Center"/>
			<TextBox x:Name="MaxTextBox" Grid.Column="1" Height="25"/>
			<!-- Поле с именем MaxTextBox -->
		</Grid>

		<!-- Строка 2: Поле "Количество" -->
		<Grid Grid.Row="2" Margin="0,0,0,15">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="120"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>
			<Label Content="Количество:" VerticalAlignment="Center"/>
			<TextBox x:Name="QuantityTextBox" Grid.Column="1" Height="25"/>
			<!-- Поле с именем QuantityTextBox -->
		</Grid>

		<!-- Строка 4: Кнопки OK и Отмена -->
		<StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
			<!-- Кнопка OK - при нажатии вызывает метод OkButton_Click -->
			<Button x:Name="OkButton" Content="OK" Width="80" Height="30"
                    Margin="0,0,10,0" Click="OkButton_Click"/>
			<!-- Кнопка Отмена - при нажатии вызывает метод CancelButton_Click -->
			<Button x:Name="CancelButton" Content="Отмена" Width="80" Height="30"
                    Click="CancelButton_Click"/>
		</StackPanel>
	</Grid>
</Window>