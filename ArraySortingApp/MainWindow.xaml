<Window x:Class="ArraySortingApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Array Sorting - Авторизация"
        Width="500" Height="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid>
        <StackPanel Width="300" VerticalAlignment="Center">
            <TextBlock Text="Личный кабинет" 
                       FontSize="18" 
                       FontWeight="Bold"
                       HorizontalAlignment="Center" 
                       Margin="0,0,0,30"/>

            <StackPanel Margin="0,0,0,15">
                <TextBlock Text="Логин:" Margin="0,0,0,5"/>
                <TextBox x:Name="LoginTextBox" 
                         Height="35" 
                         VerticalContentAlignment="Center"
                         Padding="10,0"
                         TextChanged="LoginTextBox_TextChanged"/>
            </StackPanel>

            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="Пароль:" Margin="0,0,0,5"/>
                <PasswordBox x:Name="PasswordBox" 
                             Height="35" 
                             VerticalContentAlignment="Center"
                             Padding="10,0"
                             PasswordChanged="PasswordBox_PasswordChanged"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="LoginButton" 
                        Content="Войти" 
                        Width="120" 
                        Height="35" 
                        Margin="0,0,10,0"
                        Click="LoginButton_Click"/>
                <Button x:Name="ClearButton" 
                        Content="Очистить" 
                        Width="120" 
                        Height="35" 
                        Click="ClearButton_Click"/>
            </StackPanel>

            <Button x:Name="RegisterButton" 
                    Content="Зарегистрироваться" 
                    Width="250" 
                    Height="35" 
                    Margin="0,20,0,0"
                    Click="RegisterButton_Click"/>

            <StatusBar x:Name="StatusBar" Margin="0,20,0,0">
                <StatusBarItem>
                    <TextBlock x:Name="StatusText" Text="Готов"/>
                </StatusBarItem>
            </StatusBar>
        </StackPanel>
    </Grid>
</Window>