<!-- 
  Диалоговое окно для ввода размера массива
  Появляется при нажатии кнопки "Задать размер"
-->
<Window x:Class="ArraySortingApp.Dialogs.SizeInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Размер массива"
        Width="300" Height="180"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
	<Grid Margin="20">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<!-- Текст-подсказка -->
			<RowDefinition Height="Auto"/>
			<!-- Поле ввода -->
			<RowDefinition Height="*"/>
			<!-- Пустое пространство -->
			<RowDefinition Height="Auto"/>
			<!-- Кнопки -->
		</Grid.RowDefinitions>

		<!-- Текст-инструкция -->
		<TextBlock Grid.Row="0" Text="Введите количество элементов:" Margin="0,0,0,15"/>

		<!-- Поле для ввода числа -->
		<TextBox x:Name="SizeTextBox" Grid.Row="1" Height="25" Margin="0,0,0,15"/>

		<!-- Кнопки OK и Отмена -->
		<StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
			<Button x:Name="OkButton" Content="OK" Width="80" Height="30"
                    Margin="0,0,10,0" Click="OkButton_Click"/>
			<Button x:Name="CancelButton" Content="Отмена" Width="80" Height="30"
                    Click="CancelButton_Click"/>
		</StackPanel>
	</Grid>
</Window>