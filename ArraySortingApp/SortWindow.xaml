<Window x:Class="ArraySortingApp.SortWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Сортировка массива"
        Width="1000" Height="700"
        WindowStartupLocation="CenterScreen">
	<Grid Margin="20">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<!-- Заголовок -->
		<TextBlock Grid.Row="0"
                   Text="Сортировка массива"
                   FontSize="18"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20"/>

		<!-- Панель управления -->
		<StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
			<Button x:Name="SetSizeButton" Content="Задать размер" Width="120" Height="35" Margin="0,0,10,0" Click="SetSizeButton_Click"/>
			<Button x:Name="ClearButton" Content="Очистить" Width="120" Height="35" Margin="0,0,10,0" Click="ClearButton_Click"/>
			<Button x:Name="GenerateButton" Content="Сгенерировать" Width="120" Height="35" Margin="0,0,10,0" Click="GenerateButton_Click"/>
			<Button x:Name="HistoryButton" Content="История" Width="120" Height="35" Margin="0,0,10,0" Click="HistoryButton_Click"/>
			<Button x:Name="HelpButton" Content="Справка" Width="120" Height="35" Click="HelpButton_Click"/>
		</StackPanel>

		<!-- Информация о массиве -->
		<StackPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,0,0,10">
			<TextBlock x:Name="ArrayInfoText" Text="Массив не задан" FontSize="12" Foreground="Gray"/>
		</StackPanel>

		<!-- Таблица для массива -->
		<ScrollViewer Grid.Row="3" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
			<DataGrid x:Name="ArrayDataGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserReorderColumns="False"
                      CanUserResizeRows="False"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      RowHeight="40"
                      Margin="0,0,0,20"
                      IsReadOnly="False"
                      CellEditEnding="ArrayDataGrid_CellEditEnding"
                      BeginningEdit="ArrayDataGrid_BeginningEdit">
				<DataGrid.Columns>
					<DataGridTextColumn Header="Индекс" Width="80" Binding="{Binding Index}" IsReadOnly="True"/>
					<DataGridTextColumn Header="Значение" Width="150" Binding="{Binding Value}" IsReadOnly="False"/>
				</DataGrid.Columns>
			</DataGrid>
		</ScrollViewer>

		<!-- Кнопка сортировки -->
		<Button Grid.Row="4"
                x:Name="SortButton"
                Content="Отсортировать"
                Width="200"
                Height="40"
                HorizontalAlignment="Center"
                Margin="0,0,0,20"
                Click="SortButton_Click"/>

		<!-- Статусная строка -->
		<StatusBar Grid.Row="5">
			<StatusBarItem>
				<TextBlock x:Name="StatusText" Text="Готов"/>
			</StatusBarItem>
		</StatusBar>
	</Grid>
</Window>	